[Unit]
Description=Assay grading job: re-grades our hosts (Mon, Thu), checks grade age, alerts via ntfy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=assay
# Its own checkout (branch dev while main is frozen for judging), so the hosts' /opt/assay never changes under them.
WorkingDirectory=/opt/assay-grader
# GEMINI_API_KEY, OPENROUTER_API_KEY, GRADER_TOKEN, NTFY_TOPIC (written by push-secrets.sh grader)
EnvironmentFile=/etc/assay/grader.env
StateDirectory=assay-grader
ExecStart=/usr/bin/bash harness/vm_grader.sh
# Google's endpoint has taken hours for one Gemma run.
TimeoutStartSec=10h
