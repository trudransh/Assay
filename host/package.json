{
  "name": "@assay/host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../.env src/server.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p . --noEmit",
    "keygen": "tsx --env-file-if-exists=../.env scripts/keygen.ts",
    "register": "tsx --env-file-if-exists=../.env scripts/register-agent.ts",
    "e2e": "tsx --env-file-if-exists=../.env scripts/e2e-testnet.ts",
    "e2e:local": "tsx scripts/e2e-local.ts"
  },
  "dependencies": {
    "@assay/receipts": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "jose": "6.2.12",
    "viem": "^2.57.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
