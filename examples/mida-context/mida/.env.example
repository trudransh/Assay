# Absolute path of the Mida home made for this demo (e.g. /Users/you/.mida-assay). Required.
MIDA_HOME=
# The name `write` runs as, and the only author `read` accepts. Default: assay-writer.
ASSAY_WRITER_AGENT=
# The name `read` runs as. Must differ from the writer. Default: assay-reader.
ASSAY_READER_AGENT=
# The folder both agents were approved in, as an absolute path. Default: this folder.
MIDA_PROJECT=
# Where `ask` and `write` talk to. Default: https://34-45-1-81.sslip.io
ASSAY_HOST=
# The ReceiptAnchor contract the check reads. Default: 0x63e4F42E6d254ed6aAE735F9F4169BbFd12c1a24
ASSAY_RECEIPT_ANCHOR=
# Comma-separated erc8004:<chainId>:<id> hosts the reader accepts. Default: erc8004:10143:1962
ASSAY_TRUSTED_HOSTS=
# Records and receipts from any other chain are refused. Default: 10143 (Monad testnet).
# The chain id, ASSAY_RECEIPT_ANCHOR, MONAD_RPC_URL and ASSAY_TRUSTED_HOSTS are one setting: with any
# other chain id all three must be given, and every trusted host must be on that chain.
ASSAY_CHAIN_ID=
# Where ASSAY's built SDK is (its dist/index.js). Default: ../../../sdk
ASSAY_SDK_DIR=
# Monad testnet RPC. Default: https://testnet-rpc.monad.xyz
MONAD_RPC_URL=
